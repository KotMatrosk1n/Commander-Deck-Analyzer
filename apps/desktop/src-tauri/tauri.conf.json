{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Commander Deck Analyzer",
  "version": "0.3.0",
  "identifier": "app.commanderdeckanalyzer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Commander Deck Analyzer",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; img-src 'self' asset: https://cards.scryfall.io data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/THIRD_PARTY_NOTICES.md"
    ],
    "category": "Utility",
    "shortDescription": "Local-first Commander deck analysis",
    "longDescription": "Analyze Commander deck consistency, speed, synergy, resilience, and likely bracket with transparent local simulation.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
