  "formatRules": {
    "deckSize": 100,
    "singleton": true,
    "basicLandsExempt": true,
    "colorIdentityRequired": true,
    "minimumCommanders": 1,
    "maximumCommanders": 2,
    "legendaryCreaturesEligible": true,
    "explicitOraclePermissionEligible": true,
    "legendaryVehicleOrSpacecraftNeedsPrintedPowerToughness": true
  },
  "bracketPolicy": {
    "gameChangerLimits": [
      {
        "bracket": 1,
        "maximum": 0
      },
      {
        "bracket": 2,
        "maximum": 0
      },
      {
        "bracket": 3,
        "maximum": 3
      },
      {
        "bracket": 4,
        "maximum": null
      },
      {
        "bracket": 5,
        "maximum": null
      }
    ],
    "floorWhenAtLeastOne": 3,
    "floorWhenMoreThan": 3,
    "floorAboveLimit": 4,
    "intentOnlyBrackets": [
      1,
      5
    ],
    "guidance": {
      "sourceUrls": [
        "https://magic.wizards.com/en/news/announcements/introducing-commander-brackets-beta",
        "https://magic.wizards.com/en/news/announcements/commander-brackets-beta-update-october-21-2025",
        "https://magic.wizards.com/en/news/announcements/commander-brackets-beta-update-february-9-2026"
      ],
      "expectedMinimumTurns": [
        {
          "bracket": 1,
          "minimumTurnsPlayed": 9
        },
        {
          "bracket": 2,
          "minimumTurnsPlayed": 8
        },
        {
          "bracket": 3,
          "minimumTurnsPlayed": 6
        },
        {
          "bracket": 4,
          "minimumTurnsPlayed": 4
        },
        {
          "bracket": 5,
          "minimumTurnsPlayed": null
        }
      ],
      "massLandDenialFloor": 4,
      "twoCardGameEndingFloor": 3,
      "earlyTwoCardGameEndingFloor": 4,
      "earlyGameThroughTurn": 6,
      "frequentEarlyWinAttemptRate": 0.35,
      "extraTurnCardFloor": 2,
      "extraTurnChainFloor": 4
    },
    "notes": [
      "Game Changers impose only a policy floor; zero Game Changers does not establish Bracket 1 or 2.",
      "Mass land denial is excluded from Brackets 1 through 3 and can create a deterministic Bracket 4 floor when the semantic match is sufficiently confident.",
      "Two-card game-ending lines, extra-turn chaining, and turn expectations include intent or model-dependent elements and must remain labeled as guidance or manual review.",
      "The 35% early-attempt threshold is a versioned engineering trigger for surfacing review guidance; it is not a Wizards-authored cutoff.",
      "Bracket 1 depends on theme and pod-approved flexibility, so it cannot be inferred from a decklist.",
      "Bracket 5 depends on cEDH metagame and competitive intent, so it cannot be inferred from a decklist.",
      "Commander Brackets are an optional pregame-conversation tool and remain in beta."
    ]
  },
